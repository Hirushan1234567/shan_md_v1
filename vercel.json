{
  "functions": {
    "api/pair.js": {
      "maxDuration": 300
    },
    "api/site.js": {
      "includeFiles": "web/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?p=index"
    },
    {
      "source": "/login",
      "destination": "/api/site?p=login"
    },
    {
      "source": "/dashboard",
      "destination": "/api/site?p=dashboard"
    },
    {
      "source": "/api/status",
      "destination": "/api/statu"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}